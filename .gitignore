# =============================================================
# GENOMICS PROJECT — .gitignore
# =============================================================

# ----- LARGE RAW DATA FILES (NEVER commit these) -----
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.sam
*.cram

# STAR / HISAT2 genome index folders
GenomeIndex/
StarIndex/
reference/genome/
reference/annotation/

# ----- INTERMEDIATE / SCRATCH FILES -----
data/raw/
data/trimmed/*.fastq.gz
data/trimmed/*.fq.gz

# Keep trimming REPORTS (small .txt), ignore the actual trimmed reads
!data/trimmed/*.txt

# BAM index files (large, regenerable)
*.bam.bai
*.bai

# Compressed peak files (large)
*.bed.gz
*.narrowPeak.gz
*.broadPeak.gz

# PLINK binary files (large)
*.bed
*.bim
*.fam
*.ped
*.map

# VCF / genotype files (large)
*.vcf
*.vcf.gz
*.bcf

# ----- R / RSTUDIO ARTEFACTS -----
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ----- PYTHON ARTEFACTS -----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.env
venv/

# ----- OS / EDITOR JUNK -----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# ----- LOG / TEMP FILES -----
*.log
*.tmp
*.temp
nohup.out

# ----- WHAT WE *DO* KEEP (whitelist) -----
# Scripts:        *.R, *.Rmd, *.sh, *.py
# Small outputs:  *.csv, *.txt (count matrices, DEG tables, enrichment tables)
# Plots:          *.png, *.pdf, *.svg
# HTML reports:   *.html
# Excel summaries: *.xlsx  (Task 4 interaction table — small)
# Docs:           *.pdf (project report), README.md
