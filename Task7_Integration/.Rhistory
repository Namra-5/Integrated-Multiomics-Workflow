# Read the CSV file (make sure it contains Year and Cost columns)
data <- read.csv("C:\\Users\\DELL\\Downloads\\sequencing_price.csv", header = TRUE)
# Create a line plot showing sequencing cost trend
plot(data$Year, data$Cost,
type = "b",                         # both points and lines
main = "Sequencing Cost Trend Over Years",
xlab = "Year",
ylab = "Cost (in USD)",
col = "blue",
pch = 19,                           # solid circle for points
lwd = 2,                            # thicker line for clarity
log = "y")                          # log scale for large value range
# Add grid lines
grid()
