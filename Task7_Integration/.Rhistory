# Read the CSV
data <- read.csv("C:\\Users\\DELL\\Downloads\\pie_example.csv", header = TRUE, stringsAsFactors = FALSE)
# Convert Count column to numeric
data$Count <- as.numeric(data$Count)
# Remove NA or zero values
data <- subset(data, Count > 0)
# Create pie chart
pie(data$Count,
labels = data$Genotype,
main = "Genotypic Ratio Distribution",
col = rainbow(length(data$Count)),
border = "white")
